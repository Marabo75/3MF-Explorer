<Window x:Class="ThreeMFExplorer.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="3MF-Explorer"
        WindowStartupLocation="CenterOwner"
        WindowState="Maximized"
        MinWidth="800"
        MinHeight="600"
        Background="#0C0E12"
        Foreground="White"
        KeyDown="Window_KeyDown"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.Resources>
        <SolidColorBrush x:Key="PreviewTextBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="PreviewMutedTextBrush" Color="#AAB1BE"/>
        <SolidColorBrush x:Key="PreviewBorderBrush" Color="#3B4350"/>

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#F2F4F7"/>
            <Setter Property="Background" Value="#252A34"/>
            <Setter Property="BorderBrush" Value="#3B4350"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303744"/>
                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#4C8DFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1F6FEB"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#F2F4F7"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#F2F4F7"/>
        </Style>
    </Window.Resources>

    <Grid Background="#0C0E12">
        <Grid.RowDefinitions>
            <RowDefinition Height="38"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#151922"
                BorderBrush="#2B313C"
                BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                    <ColumnDefinition Width="46"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="TxtWindowTitle"
                           Grid.Column="0"
                           Text="3MF-Explorer – Vorschau"
                           Foreground="#F2F4F7"
                           FontSize="12"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="14,0,0,0"/>

                <Button Grid.Column="1" Content="—" FontSize="14"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Minimieren" Click="BtnMinimize_Click"/>
                <Button x:Name="BtnMaximize" Grid.Column="2" Content="□" FontSize="14"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Maximieren" Click="BtnMaximize_Click"/>
                <Button Grid.Column="3" Content="×" FontSize="18"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Schließen" Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="#171A21"
                BorderBrush="#2B313B"
                BorderThickness="0,0,0,1"
                Padding="14,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle"
                               FontSize="15"
                               FontWeight="SemiBold"
                               Foreground="White"/>
                    <TextBlock x:Name="TxtMode"
                               Margin="12,0,0,0"
                               FontSize="12"
                               Foreground="#AAB1BE"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Column="1"
                        x:Name="PrinterControls3D"
                        Visibility="Collapsed"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center">
                    <Grid>
                        <Button x:Name="BtnPrinterMenu"
                                Width="38"
                                Height="30"
                                Padding="8,5"
                                ToolTip="Drucker und Druckplatte"
                                Click="BtnPrinterMenu_Click">
                            <Viewbox Stretch="Uniform">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#D8DCE3" Data="M6,2 H18 V7 H20 C21.1,7 22,7.9 22,9 V16 H19 V22 H5 V16 H2 V9 C2,7.9 2.9,7 4,7 H6 Z M8,4 V7 H16 V4 Z M7,14 V20 H17 V14 Z M18.5,9.5 A1,1 0 1 0 18.5,11.5 A1,1 0 1 0 18.5,9.5"/>
                                </Canvas>
                            </Viewbox>
                        </Button>

                        <Popup x:Name="PrinterMenuPopup"
                               PlacementTarget="{Binding ElementName=BtnPrinterMenu}"
                               Placement="Bottom"
                               StaysOpen="False"
                               AllowsTransparency="True">
                            <Border Margin="0,5,0,0"
                                    Padding="14"
                                    Width="250"
                                    Background="#F2171A21"
                                    BorderBrush="#3B4350"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <TextBlock x:Name="LblPrinter3D"
                                               Text="Drucker"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="#AEB6C3"
                                               Margin="0,0,0,6"/>
                                    <ComboBox x:Name="CmbPrinterProfile"
                                              Height="32"
                                              FontSize="12"
                                              SelectionChanged="CmbPrinterProfile_SelectionChanged"/>
                                    <CheckBox x:Name="ChkShowBuildPlate"
                                              Content="Druckplatte anzeigen"
                                              IsChecked="True"
                                              Margin="0,10,0,0"
                                              Foreground="#DCE2EA"
                                              FontSize="12"
                                              Cursor="Hand"
                                              Checked="ChkShowBuildPlate_Changed"
                                              Unchecked="ChkShowBuildPlate_Changed"/>
                                    <CheckBox x:Name="ChkShowOriginalBuildPlate"
                                              Content="Original-Druckplatte anzeigen"
                                              IsChecked="False"
                                              Margin="0,7,0,0"
                                              Foreground="#DCE2EA"
                                              FontSize="12"
                                              Cursor="Hand"
                                              Checked="ChkShowOriginalBuildPlate_Changed"
                                              Unchecked="ChkShowOriginalBuildPlate_Changed"/>
                                </StackPanel>
                            </Border>
                        </Popup>
                    </Grid>
                </Border>

                <Grid Grid.Column="2"
                      x:Name="ViewControls3D"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <Button x:Name="BtnViewMenu"
                            Content="◉"
                            Width="38"
                            Height="30"
                            Padding="0"
                            FontSize="14"
                            ToolTip="3D-Ansicht"
                            IsEnabled="False"
                            Click="BtnViewMenu_Click"/>

                    <Popup x:Name="ViewMenuPopup"
                           PlacementTarget="{Binding ElementName=BtnViewMenu}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Margin="0,5,0,0"
                                Padding="7"
                                Width="190"
                                Background="#F2171A21"
                                BorderBrush="#3B4350"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <Button x:Name="BtnViewIso" Content="Isometrisch" Tag="Iso" Padding="9,6" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                <Button x:Name="BtnViewTop" Content="Oben" Tag="Top" Padding="9,6" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                <Button x:Name="BtnViewFront" Content="Vorne" Tag="Front" Padding="9,6" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                <Button x:Name="BtnViewBack" Content="Hinten" Tag="Back" Padding="9,6" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                <Button x:Name="BtnViewLeft" Content="Links" Tag="Left" Padding="9,6" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                <Button x:Name="BtnViewRight" Content="Rechts" Tag="Right" Padding="9,6" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                <Separator Margin="4"/>
                                <Button x:Name="BtnViewReset" Content="Ansicht zurücksetzen" Tag="Reset" Padding="9,6" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Grid Grid.Column="3"
                      x:Name="PlateControls3D"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <Button x:Name="BtnPlateMenu"
                            Content="▤"
                            Width="38"
                            Height="30"
                            Padding="0"
                            FontSize="14"
                            ToolTip="Druckplatten"
                            IsEnabled="False"
                            Click="BtnPlateMenu_Click"/>

                    <Popup x:Name="PlateMenuPopup"
                           PlacementTarget="{Binding ElementName=BtnPlateMenu}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Margin="0,5,0,0"
                                Padding="10"
                                Width="330"
                                Background="#F2171A21"
                                BorderBrush="#3B4350"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="LblPlates3D"
                                           Text="Druckplatten"
                                           FontWeight="SemiBold"
                                           Foreground="#F0F3F8"
                                           Margin="3,1,3,7"/>
                                <ScrollViewer MaxHeight="430"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PlatesPanel3D"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Grid Grid.Column="4"
                      x:Name="ObjectControls3D"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <Button x:Name="BtnObjectsMenu"
                            Content="▦"
                            Width="38"
                            Height="30"
                            Padding="0"
                            FontSize="14"
                            ToolTip="Objekte"
                            IsEnabled="False"
                            Click="BtnObjectsMenu_Click"/>

                    <Popup x:Name="ObjectsMenuPopup"
                           PlacementTarget="{Binding ElementName=BtnObjectsMenu}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Margin="0,5,0,0"
                                Padding="12"
                                Width="330"
                                Background="#F2171A21"
                                BorderBrush="#3B4350"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="LblObjects3D"
                                           Text="Objekte"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="#F0F3F8"/>

                                <TextBlock x:Name="TxtObjectsSummary3D"
                                           Margin="0,2,0,9"
                                           FontSize="10"
                                           Foreground="#9EA7B5"/>

                                <Border Background="#101319"
                                        BorderBrush="#2E3540"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="4">
                                    <ScrollViewer MaxHeight="280"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel x:Name="ObjectsPanel3D"/>
                                    </ScrollViewer>
                                </Border>

                                <Grid Margin="0,9,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Button x:Name="BtnShowAllObjects"
                                            Grid.Column="0"
                                            Content="Alle anzeigen"
                                            Padding="9,6"
                                            Click="BtnShowAllObjects_Click"/>

                                    <Button x:Name="BtnFocusObject"
                                            Grid.Column="2"
                                            Content="Objekt fokussieren"
                                            Padding="9,6"
                                            IsEnabled="False"
                                            Click="BtnFocusObject_Click"/>
                                </Grid>

                                <Button x:Name="BtnIsolateObject"
                                        Content="Nur Auswahl anzeigen"
                                        Margin="0,8,0,0"
                                        Padding="9,6"
                                        IsEnabled="False"
                                        Click="BtnIsolateObject_Click"/>

                                <TextBlock x:Name="TxtSelectedObjectInfo3D"
                                           Margin="0,9,0,0"
                                           FontSize="10"
                                           Foreground="#B7C0CD"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Button Grid.Column="5"
                        x:Name="BtnClose"
                        Content="✕"
                        Width="38"
                        Height="30"
                        Padding="0"
                        FontSize="14"
                        ToolTip="Close"
                        Click="BtnClose_Click"/>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="#0C0E12">
            <Image x:Name="ImgPreviewLarge"
                   Margin="20"
                   Stretch="Uniform"/>

            <Viewport3D x:Name="ModelViewportLarge"
                        Margin="10"
                        Visibility="Collapsed"
                        Focusable="True"
                        Cursor="Hand"
                        MouseLeftButtonDown="ModelViewport_MouseLeftButtonDown"
                        MouseLeftButtonUp="ModelViewport_MouseLeftButtonUp"
                        MouseRightButtonDown="ModelViewport_MouseRightButtonDown"
                        MouseRightButtonUp="ModelViewport_MouseRightButtonUp"
                        MouseMove="ModelViewport_MouseMove"
                        MouseWheel="ModelViewport_MouseWheel">
                <Viewport3D.Camera>
                    <PerspectiveCamera x:Name="ModelCameraLarge"
                                       Position="0,0,200"
                                       LookDirection="0,0,-200"
                                       UpDirection="0,1,0"
                                       FieldOfView="45"/>
                </Viewport3D.Camera>
                <ModelVisual3D x:Name="ModelVisualLarge"/>
                <ModelVisual3D x:Name="BuildPlateVisualLarge"/>
                <ModelVisual3D x:Name="BuildVolumeWarningVisualLarge"/>
            </Viewport3D>

            <Border x:Name="OrientationGizmoContainer"
                    Visibility="Collapsed"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Width="104"
                    Height="104"
                    Margin="24"
                    Background="#C611141A"
                    BorderBrush="#343B47"
                    BorderThickness="1"
                    CornerRadius="9"
                    IsHitTestVisible="False">
                <Canvas Width="102"
                        Height="102">
                    <Line x:Name="AxisXLine"
                          X1="51" Y1="51"
                          X2="84" Y2="51"
                          Stroke="#FF6666"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <Line x:Name="AxisYLine"
                          X1="51" Y1="51"
                          X2="51" Y2="18"
                          Stroke="#62D986"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>
                    <Line x:Name="AxisZLine"
                          X1="51" Y1="51"
                          X2="33" Y2="69"
                          Stroke="#5DA9FF"
                          StrokeThickness="3"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"/>

                    <Ellipse Width="7"
                             Height="7"
                             Canvas.Left="47.5"
                             Canvas.Top="47.5"
                             Fill="#E6EAF0"/>

                    <TextBlock x:Name="AxisXLabel"
                               Text="X"
                               Canvas.Left="87"
                               Canvas.Top="42"
                               Foreground="#FF8A8A"
                               FontSize="12"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="AxisYLabel"
                               Text="Y"
                               Canvas.Left="47"
                               Canvas.Top="3"
                               Foreground="#85E6A2"
                               FontSize="12"
                               FontWeight="Bold"/>
                    <TextBlock x:Name="AxisZLabel"
                               Text="Z"
                               Canvas.Left="21"
                               Canvas.Top="70"
                               Foreground="#82BCFF"
                               FontSize="12"
                               FontWeight="Bold"/>
                </Canvas>
            </Border>

            <Border x:Name="ModelInfo3DContainer"
                    Visibility="Collapsed"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="24,72,24,24"
                    Padding="12,9"
                    Background="#E611141A"
                    BorderBrush="#343B47"
                    BorderThickness="1"
                    CornerRadius="7"
                    IsHitTestVisible="False">
                <StackPanel>
                    <TextBlock x:Name="TxtPrinterProfile3D"
                               FontSize="13"
                               FontWeight="SemiBold"
                               Foreground="#F0F3F8"/>
                    <TextBlock x:Name="TxtModelSize3D"
                               Margin="0,4,0,0"
                               FontSize="11"
                               Foreground="#C5CBD5"/>
                    <TextBlock x:Name="TxtBuildVolume3D"
                               Margin="0,2,0,0"
                               FontSize="11"
                               Foreground="#C5CBD5"/>
                    <TextBlock x:Name="TxtFitStatus3D"
                               Margin="0,6,0,0"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#B9E6C4"
                               TextWrapping="Wrap"
                               MaxWidth="340"/>
                </StackPanel>
            </Border>

            <Border x:Name="Txt3DHintContainer"
                    Visibility="Collapsed"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Center"
                    Margin="20"
                    Padding="10,6"
                    Background="#DD11141A"
                    CornerRadius="6"
                    IsHitTestVisible="False">
                <TextBlock x:Name="Txt3DHint"
                           FontSize="11"
                           Foreground="#AAB1BE"
                           TextAlignment="Center"/>
            </Border>
        </Grid>
            </Grid>
</Grid>
</Window>
