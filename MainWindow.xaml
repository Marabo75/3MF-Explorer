<Window x:Class="ThreeMFExplorer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="3MF-Explorer"
        Icon="3MF-Explorer.ico"
        Width="1600"
        Height="900"
        MinWidth="1100"
        MinHeight="650"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#0F1115"
        Foreground="#F2F4F7">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#171A21"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1D212A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A303B"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#939BAA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>

        <!-- BUTTONS -->

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#252A34"/>
            <Setter Property="BorderBrush" Value="#353C48"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#303744"/>

                                <Setter TargetName="ButtonBorder"
                                        Property="BorderBrush"
                                        Value="#4C8DFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1F6FEB"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TITELLEISTEN-BUTTONS -->

        <Style x:Key="TitleBarButtonStyle"
               TargetType="Button">

            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="#DDE1E7"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Arrow"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="TitleButtonBorder"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="TitleButtonBorder"
                                        Property="Background"
                                        Value="#2A303A"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="TitleButtonBorder"
                                        Property="Background"
                                        Value="#353C48"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style x:Key="CloseTitleBarButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource TitleBarButtonStyle}">

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="CloseButtonBorder"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CloseButtonBorder"
                                        Property="Background"
                                        Value="#C42B1C"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="CloseButtonBorder"
                                        Property="Background"
                                        Value="#A52217"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- TEXTBOX -->

        <Style TargetType="TextBox">

            <Setter Property="Foreground"
                    Value="{StaticResource TextBrush}"/>

            <Setter Property="Background"
                    Value="#11141A"/>

            <Setter Property="BorderBrush"
                    Value="{StaticResource BorderBrush}"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="CaretBrush"
                    Value="White"/>

            <Setter Property="FontSize"
                    Value="13"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

        </Style>

        <!-- DARK COMBOBOX -->

        <Style x:Key="DarkComboBoxItemStyle"
               TargetType="ComboBoxItem">

            <Setter Property="Foreground"
                    Value="#F2F4F7"/>

            <Setter Property="Background"
                    Value="#1D212A"/>

            <Setter Property="Padding"
                    Value="12,8"/>

            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch"/>

            <Setter Property="VerticalContentAlignment"
                    Value="Center"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBoxItem">

                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}"
                                Padding="{TemplateBinding Padding}"
                                CornerRadius="5"
                                Margin="3,1">

                            <ContentPresenter
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsHighlighted"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#343B47"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsSelected"
                                     Value="True">

                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="#1F6FEB"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                                <Setter Property="FontWeight"
                                        Value="SemiBold"/>

                            </Trigger>

                            <Trigger Property="IsEnabled"
                                     Value="False">

                                <Setter Property="Foreground"
                                        Value="#626A78"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <Style TargetType="ComboBox">

            <Setter Property="Foreground"
                    Value="#FFFFFF"/>

            <Setter Property="Background"
                    Value="#252A34"/>

            <Setter Property="BorderBrush"
                    Value="#3B4350"/>

            <Setter Property="BorderThickness"
                    Value="1"/>

            <Setter Property="FontSize"
                    Value="12"/>

            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource DarkComboBoxItemStyle}"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ComboBox">

                        <Grid>

                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen,
                                              Mode=TwoWay,
                                              RelativeSource={RelativeSource TemplatedParent}}">

                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">

                                        <Border x:Name="ComboBorder"
                                                Background="#252A34"
                                                BorderBrush="#3B4350"
                                                BorderThickness="1"
                                                CornerRadius="7">

                                            <Grid>

                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="34"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="1"
                                                        Background="#20252E"
                                                        CornerRadius="0,7,7,0">

                                                    <Path Width="8"
                                                          Height="5"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"
                                                          Fill="#D8DCE3"
                                                          Data="M 0 0 L 8 0 L 4 5 Z"/>

                                                </Border>

                                            </Grid>

                                        </Border>

                                        <ControlTemplate.Triggers>

                                            <Trigger Property="IsMouseOver"
                                                     Value="True">

                                                <Setter TargetName="ComboBorder"
                                                        Property="BorderBrush"
                                                        Value="#4C8DFF"/>

                                                <Setter TargetName="ComboBorder"
                                                        Property="Background"
                                                        Value="#2B313C"/>

                                            </Trigger>

                                            <Trigger Property="IsChecked"
                                                     Value="True">

                                                <Setter TargetName="ComboBorder"
                                                        Property="BorderBrush"
                                                        Value="#4C8DFF"/>

                                            </Trigger>

                                        </ControlTemplate.Triggers>

                                    </ControlTemplate>
                                </ToggleButton.Template>

                            </ToggleButton>

                            <ContentPresenter x:Name="ContentSite"
                                              Margin="12,0,38,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              TextElement.Foreground="#FFFFFF"/>

                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   PopupAnimation="Fade">

                                <Border Background="#1D212A"
                                        BorderBrush="#3B4350"
                                        BorderThickness="1"
                                        CornerRadius="7"
                                        Margin="0,4,0,0"
                                        MinWidth="{Binding ActualWidth,
                                            RelativeSource={RelativeSource TemplatedParent}}">

                                    <ScrollViewer Margin="2"
                                                  SnapsToDevicePixels="True"
                                                  VerticalScrollBarVisibility="Auto"
                                                  HorizontalScrollBarVisibility="Disabled">

                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Contained"/>

                                    </ScrollViewer>

                                </Border>

                            </Popup>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- TREEVIEW -->

        <Style TargetType="TreeView">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <Style TargetType="TreeViewItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="3"/>
            <Setter Property="Margin" Value="0,2"/>
        </Style>

        <!-- KONTEXTMENÜ -->

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="#20242C"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="BorderBrush" Value="#363D49"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="4"/>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,7"/>
        </Style>


        <!-- ================================================= -->
        <!-- DARK SCROLLBARS                                   -->
        <!-- ================================================= -->

        <ControlTemplate x:Key="VerticalScrollBarTemplate"
                         TargetType="ScrollBar">
            <Grid Width="10"
                  Background="#101217">

                <Track x:Name="PART_Track"
                       IsDirectionReversed="True">

                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageUpCommand"
                                      Opacity="0"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb MinHeight="32"
                               Margin="2,2"
                               Cursor="Hand">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbBorder"
                                            Background="#3A414D"
                                            CornerRadius="3"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBorder"
                                                    Property="Background"
                                                    Value="#586272"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbBorder"
                                                    Property="Background"
                                                    Value="#4C8DFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageDownCommand"
                                      Opacity="0"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>

                </Track>
            </Grid>
        </ControlTemplate>

        <ControlTemplate x:Key="HorizontalScrollBarTemplate"
                         TargetType="ScrollBar">
            <Grid Height="10"
                  Background="#101217">

                <Track x:Name="PART_Track"
                       Orientation="Horizontal">

                    <Track.DecreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageLeftCommand"
                                      Opacity="0"
                                      Focusable="False"/>
                    </Track.DecreaseRepeatButton>

                    <Track.Thumb>
                        <Thumb MinWidth="32"
                               Margin="2,2"
                               Cursor="Hand">
                            <Thumb.Template>
                                <ControlTemplate TargetType="Thumb">
                                    <Border x:Name="ThumbBorder"
                                            Background="#3A414D"
                                            CornerRadius="3"/>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="ThumbBorder"
                                                    Property="Background"
                                                    Value="#586272"/>
                                        </Trigger>
                                        <Trigger Property="IsDragging" Value="True">
                                            <Setter TargetName="ThumbBorder"
                                                    Property="Background"
                                                    Value="#4C8DFF"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Thumb.Template>
                        </Thumb>
                    </Track.Thumb>

                    <Track.IncreaseRepeatButton>
                        <RepeatButton Command="ScrollBar.PageRightCommand"
                                      Opacity="0"
                                      Focusable="False"/>
                    </Track.IncreaseRepeatButton>

                </Track>
            </Grid>
        </ControlTemplate>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#101217"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template"
                    Value="{StaticResource VerticalScrollBarTemplate}"/>

            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto"/>
                    <Setter Property="Height" Value="10"/>
                    <Setter Property="Template"
                            Value="{StaticResource HorizontalScrollBarTemplate}"/>
                </Trigger>
            </Style.Triggers>
        </Style>

    </Window.Resources>

    <Border BorderBrush="#292E37"
            BorderThickness="1,0,1,1"
            Background="#0F1115">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="74"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="42"/>
            </Grid.RowDefinitions>

            <!-- EIGENE TITELLEISTE -->

            <Border Grid.Row="0"
                    Background="#14171D"
                    BorderBrush="#292E37"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                IsHitTestVisible="False">

                        <Image Source="3MF-Explorer.ico"
                               Width="18"
                               Height="18"
                               Stretch="Uniform"
                               Margin="0,0,9,0"/>

                        <TextBlock Text="3MF-Explorer"
                                   Foreground="#E8EBF0"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right">

                        <Button x:Name="BtnMinimize"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Content="—"
                                ToolTip="Minimieren"
                                Click="BtnMinimize_Click"/>

                        <Button x:Name="BtnMaximize"
                                Style="{StaticResource TitleBarButtonStyle}"
                                Content="□"
                                ToolTip="Maximieren"
                                Click="BtnMaximize_Click"/>

                        <Button x:Name="BtnClose"
                                Style="{StaticResource CloseTitleBarButtonStyle}"
                                Content="×"
                                ToolTip="Schließen"
                                FontSize="18"
                                Click="BtnClose_Click"/>

                    </StackPanel>

                </Grid>

            </Border>

            <!-- HEADER -->

            <Border Grid.Row="1"
                    Background="#14171D"
                    BorderBrush="#292E37"
                    BorderThickness="0,0,0,1">

                <Grid Margin="22,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="380"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <Border Width="38"
                                Height="38"
                                Background="#4C8DFF"
                                CornerRadius="9"
                                Margin="0,0,12,0">

                            <Image Source="3MF-Explorer.ico"
                                   Width="28"
                                   Height="28"
                                   Stretch="Uniform"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>

                        </Border>

                        <StackPanel VerticalAlignment="Center">

                            <TextBlock Text="3MF-Explorer"
                                       FontSize="20"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock x:Name="TxtSubtitle" Text="3MF Modellbibliothek"
                                       FontSize="11"
                                       Foreground="{StaticResource SecondaryTextBrush}"/>

                        </StackPanel>

                    </StackPanel>

                    <!-- HILFE -->

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Button x:Name="BtnDE" Content="DE" Width="46" Height="38" Padding="0" Margin="0,0,4,0" ToolTip="Deutsch" Click="BtnDE_Click"/>
                        <Button x:Name="BtnEN" Content="EN" Width="46" Height="38" Padding="0" Margin="0,0,12,0" ToolTip="English" Click="BtnEN_Click"/>
                        <Button x:Name="BtnHelp" Content="?  Hilfe" Height="38" MinWidth="92" Padding="14,0" VerticalAlignment="Center" ToolTip="Bedienungsanleitung öffnen" Click="BtnHelp_Click"/>
                    </StackPanel>

                    <!-- SUCHE -->

                    <Grid Grid.Column="3"
                          VerticalAlignment="Center">

                        <Border Background="#0F1217"
                                BorderBrush="#303641"
                                BorderThickness="1"
                                CornerRadius="8">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="38"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="⌕"
                                           FontSize="22"
                                           Foreground="#7F8898"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>

                                <TextBox x:Name="TxtSuche"
                                         Grid.Column="1"
                                         Height="40"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0,0,10,0"
                                         ToolTip="3MF-Dateien durchsuchen"
                                         TextChanged="TxtSuche_TextChanged"/>

                            </Grid>

                        </Border>

                    </Grid>

                </Grid>

            </Border>

            <!-- HAUPTBEREICH -->

            <Grid Grid.Row="2">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="5"/>
                    <ColumnDefinition Width="410"/>
                </Grid.ColumnDefinitions>

                <!-- ORDNER -->

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">

                    <Grid Margin="16">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="TxtFolderHeading" Grid.Row="0"
                                   Text="ORDNER"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource SecondaryTextBrush}"
                                   Margin="4,3,0,12"/>

                        <Button x:Name="BtnOrdner"
                                Grid.Row="1"
                                Height="38"
                                HorizontalAlignment="Stretch"
                                Content="Ordner auswählen"
                                Click="BtnOrdner_Click"/>

                        <Border Grid.Row="2"
                                Margin="0,12,0,12"
                                Padding="10"
                                Background="#11141A"
                                BorderBrush="#292F39"
                                BorderThickness="1"
                                CornerRadius="7">

                            <TextBlock x:Name="TxtOrdner"
                                       Foreground="#AAB1BE"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>

                        </Border>

                        <TreeView x:Name="TreeFolders"
                                  Grid.Row="3"
                                  SelectedItemChanged="TreeFolders_SelectedItemChanged"/>

                    </Grid>

                </Border>

                <GridSplitter Grid.Column="1"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              Background="#101217"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- GALERIE -->

                <Grid Grid.Column="2"
                      Background="#0F1115">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="58"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="20,0">

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <TextBlock x:Name="TxtModelsHeading" Text="Modelle"
                                       FontSize="18"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <Border Background="#232832"
                                    CornerRadius="10"
                                    Padding="8,2"
                                    Margin="10,0,0,0">

                                <TextBlock x:Name="TxtAnzahl"
                                           Text="Dateien: 0"
                                           FontSize="11"
                                           Foreground="#AAB1BE"/>

                            </Border>

                        </StackPanel>

                        <!-- SORTIERUNG + ANSICHT -->

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">

                            <Button x:Name="BtnFavoritenFilter"
                                    Content="☆ Nur Favoriten"
                                    Height="36"
                                    MinWidth="125"
                                    Padding="12,0"
                                    Margin="0,0,18,0"
                                    ToolTip="Nur als Favorit markierte Modelle anzeigen"
                                    Click="BtnFavoritenFilter_Click"/>

                            <TextBlock x:Name="TxtSortLabel" Text="Sortieren:"
                                       Foreground="#AAB1BE"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>

                            <ComboBox x:Name="CmbSortierung"
                                      Width="175"
                                      Height="36"
                                      SelectedIndex="0"
                                      SelectionChanged="CmbSortierung_SelectionChanged">

                                <ComboBoxItem x:Name="CmbSortNameAsc" Content="Name A–Z"
                                              Tag="NameAsc"/>

                                <ComboBoxItem x:Name="CmbSortNameDesc" Content="Name Z–A"
                                              Tag="NameDesc"/>

                                <ComboBoxItem x:Name="CmbSortDateDesc" Content="Neueste zuerst"
                                              Tag="DateDesc"/>

                                <ComboBoxItem x:Name="CmbSortDateAsc" Content="Älteste zuerst"
                                              Tag="DateAsc"/>

                                <ComboBoxItem x:Name="CmbSortSizeDesc" Content="Größte zuerst"
                                              Tag="SizeDesc"/>

                                <ComboBoxItem x:Name="CmbSortSizeAsc" Content="Kleinste zuerst"
                                              Tag="SizeAsc"/>

                            </ComboBox>

                            <TextBlock x:Name="TxtViewLabel" Text="Ansicht:"
                                       Foreground="#AAB1BE"
                                       FontSize="12"
                                       VerticalAlignment="Center"
                                       Margin="18,0,8,0"/>

                            <ComboBox x:Name="CmbAnsicht"
                                      Width="120"
                                      Height="36"
                                      SelectedIndex="1"
                                      SelectionChanged="CmbAnsicht_SelectionChanged">

                                <ComboBoxItem x:Name="CmbViewSmall" Content="Klein"
                                              Tag="Small"/>

                                <ComboBoxItem x:Name="CmbViewMedium" Content="Mittel"
                                              Tag="Medium"/>

                                <ComboBoxItem x:Name="CmbViewLarge" Content="Groß"
                                              Tag="Large"/>

                            </ComboBox>

                        </StackPanel>

                    </Grid>

                    <ScrollViewer Grid.Row="1"
                                  Margin="10,0,10,10"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <WrapPanel x:Name="ThumbnailPanel"/>

                    </ScrollViewer>

                </Grid>

                <GridSplitter Grid.Column="3"
                              Width="5"
                              HorizontalAlignment="Stretch"
                              Background="#101217"
                              ResizeDirection="Columns"
                              ResizeBehavior="PreviousAndNext"/>

                <!-- VORSCHAU -->

                <Border Grid.Column="4"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1,0,0,0">

                    <ScrollViewer VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">

                        <StackPanel Margin="20">

                            <Grid Margin="0,3,0,12">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <TextBlock x:Name="TxtPreviewHeading"
                                           Grid.Row="0"
                                           Text="VORSCHAU"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,0,8"/>

                                <StackPanel Grid.Row="1"
                                            Orientation="Horizontal"
                                            HorizontalAlignment="Left">
                                    <Border x:Name="PrinterControls3D"
                                            Visibility="Visible"
                                            Margin="0,0,5,0">
                                        <Grid>
                                            <Button x:Name="BtnPrinterMenu"
                                                    Width="36"
                                                    Height="28"
                                                    Padding="7,4"
                                                    Background="#17283B"
                                                    BorderBrush="#365D87"
                                                    ToolTip="Drucker und Druckplatte"
                                                    Click="BtnPrinterMenu_Click">
                                                <Viewbox Stretch="Uniform">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="#7DB7FF" Data="M6,2 H18 V7 H20 C21.1,7 22,7.9 22,9 V16 H19 V22 H5 V16 H2 V9 C2,7.9 2.9,7 4,7 H6 Z M8,4 V7 H16 V4 Z M7,14 V20 H17 V14 Z M18.5,9.5 A1,1 0 1 0 18.5,11.5 A1,1 0 1 0 18.5,9.5"/>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>

                                            <Popup x:Name="PrinterMenuPopup"
                                                   PlacementTarget="{Binding ElementName=BtnPrinterMenu}"
                                                   Placement="Bottom"
                                                   StaysOpen="False"
                                                   AllowsTransparency="True">
                                                <Border Margin="0,5,0,0"
                                                        Padding="12"
                                                        Width="210"
                                                        Background="#F2171A21"
                                                        BorderBrush="#3B4350"
                                                        BorderThickness="1"
                                                        CornerRadius="8">
                                                    <StackPanel>
                                                        <TextBlock x:Name="LblPrinter3D"
                                                                   Text="Drucker"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#AEB6C3"
                                                                   Margin="0,0,0,6"/>
                                                        <ComboBox x:Name="CmbPrinterProfile"
                                                                  Height="30"
                                                                  FontSize="10"
                                                                  SelectionChanged="CmbPrinterProfile_SelectionChanged"/>
                                                        <CheckBox x:Name="ChkShowBuildPlate"
                                                                  Content="Druckplatte anzeigen"
                                                                  IsChecked="True"
                                                                  Margin="0,9,0,0"
                                                                  Foreground="#DCE2EA"
                                                                  FontSize="10"
                                                                  Cursor="Hand"
                                                                  Checked="ChkShowBuildPlate_Changed"
                                                                  Unchecked="ChkShowBuildPlate_Changed"/>
                                                        <CheckBox x:Name="ChkShowOriginalBuildPlate"
                                                                  Content="Original-Druckplatte anzeigen"
                                                                  IsChecked="False"
                                                                  Margin="0,6,0,0"
                                                                  Foreground="#DCE2EA"
                                                                  FontSize="10"
                                                                  Cursor="Hand"
                                                                  Checked="ChkShowOriginalBuildPlate_Changed"
                                                                  Unchecked="ChkShowOriginalBuildPlate_Changed"/>
                                                    </StackPanel>
                                                </Border>
                                            </Popup>
                                        </Grid>
                                    </Border>

                                    <Grid x:Name="ViewControls3D"
                                          Margin="0,0,5,0">
                                        <Button x:Name="BtnViewMenu"
                                                Content="⌖"
                                                Width="36"
                                                Height="28"
                                                Padding="0"
                                                FontSize="15"
                                                FontWeight="SemiBold"
                                                Foreground="#C6A7FF"
                                                Background="#2A2138"
                                                BorderBrush="#68528F"
                                                ToolTip="3D-Ansicht"
                                                IsEnabled="False"
                                                Click="BtnViewMenu_Click"/>

                                        <Popup x:Name="ViewMenuPopup"
                                               PlacementTarget="{Binding ElementName=BtnViewMenu}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True">
                                            <Border Margin="0,5,0,0"
                                                    Padding="6"
                                                    Width="175"
                                                    Background="#F2171A21"
                                                    BorderBrush="#3B4350"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <Button x:Name="BtnViewIso" Content="Isometrisch" Tag="Iso" Padding="8,5" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                                    <Button x:Name="BtnViewTop" Content="Oben" Tag="Top" Padding="8,5" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                                    <Button x:Name="BtnViewFront" Content="Vorne" Tag="Front" Padding="8,5" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                                    <Button x:Name="BtnViewBack" Content="Hinten" Tag="Back" Padding="8,5" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                                    <Button x:Name="BtnViewLeft" Content="Links" Tag="Left" Padding="8,5" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                                    <Button x:Name="BtnViewRight" Content="Rechts" Tag="Right" Padding="8,5" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                                    <Separator Margin="4"/>
                                                    <Button x:Name="BtnViewReset" Content="Ansicht zurücksetzen" Tag="Reset" Padding="8,5" HorizontalContentAlignment="Left" Click="Btn3DView_Click"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <Grid x:Name="PlateControls3D"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center">
                    <Button x:Name="BtnPlateMenu"
                            Content="▤"
                            Width="36"
                            Height="28"
                            Padding="0"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="#FFD27A"
                            Background="#382E1C"
                            BorderBrush="#80632F"
                            ToolTip="Druckplatten"
                            IsEnabled="False"
                            Click="BtnPlateMenu_Click"/>

                    <Popup x:Name="PlateMenuPopup"
                           PlacementTarget="{Binding ElementName=BtnPlateMenu}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True">
                        <Border Margin="0,5,0,0"
                                Padding="10"
                                Width="330"
                                Background="#F2171A21"
                                BorderBrush="#3B4350"
                                BorderThickness="1"
                                CornerRadius="8">
                            <StackPanel>
                                <TextBlock x:Name="LblPlates3D"
                                           Text="Druckplatten"
                                           FontWeight="SemiBold"
                                           Foreground="#F0F3F8"
                                           Margin="3,1,3,7"/>
                                <ScrollViewer MaxHeight="430"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <StackPanel x:Name="PlatesPanel3D"/>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>

                <Grid x:Name="ObjectControls3D"
                                          Margin="0,0,5,0">
                                        <Button x:Name="BtnObjectsMenu"
                                                Content="▦"
                                                Width="36"
                                                Height="28"
                                                Padding="0"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="#7FE0B5"
                                                Background="#19342B"
                                                BorderBrush="#376B59"
                                                ToolTip="Objekte"
                                                IsEnabled="False"
                                                Click="BtnObjectsMenu_Click"/>

                                        <Popup x:Name="ObjectsMenuPopup"
                                               PlacementTarget="{Binding ElementName=BtnObjectsMenu}"
                                               Placement="Bottom"
                                               StaysOpen="False"
                                               AllowsTransparency="True">
                                            <Border Margin="0,5,0,0"
                                                    Padding="10"
                                                    Width="300"
                                                    Background="#F2171A21"
                                                    BorderBrush="#3B4350"
                                                    BorderThickness="1"
                                                    CornerRadius="8">
                                                <StackPanel>
                                                    <TextBlock x:Name="LblObjects3D"
                                                               Text="Objekte"
                                                               FontSize="11"
                                                               FontWeight="SemiBold"
                                                               Foreground="#F0F3F8"/>

                                                    <TextBlock x:Name="TxtObjectsSummary3D"
                                                               Margin="0,2,0,8"
                                                               FontSize="9"
                                                               Foreground="#9EA7B5"/>

                                                    <Border Background="#101319"
                                                            BorderBrush="#2E3540"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="4">
                                                        <ScrollViewer MaxHeight="210"
                                                                      VerticalScrollBarVisibility="Auto">
                                                            <StackPanel x:Name="ObjectsPanel3D"/>
                                                        </ScrollViewer>
                                                    </Border>

                                                    <Grid Margin="0,8,0,0">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="8"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Button x:Name="BtnShowAllObjects"
                                                                Grid.Column="0"
                                                                Content="Alle anzeigen"
                                                                Padding="8,5"
                                                                Click="BtnShowAllObjects_Click"/>

                                                        <Button x:Name="BtnFocusObject"
                                                                Grid.Column="2"
                                                                Content="Objekt fokussieren"
                                                                Padding="8,5"
                                                                IsEnabled="False"
                                                                Click="BtnFocusObject_Click"/>
                                                    </Grid>

                                                    <Button x:Name="BtnIsolateObject"
                                        Content="Nur Auswahl anzeigen"
                                        Margin="0,8,0,0"
                                        Padding="9,6"
                                        IsEnabled="False"
                                        Click="BtnIsolateObject_Click"/>

                                <TextBlock x:Name="TxtSelectedObjectInfo3D"
                                                               Margin="0,8,0,0"
                                                               FontSize="9"
                                                               Foreground="#B7C0CD"
                                                               TextWrapping="Wrap"/>
                                                </StackPanel>
                                            </Border>
                                        </Popup>
                                    </Grid>

                                    <Button x:Name="BtnPreview2D"
                                            Content="2D"
                                            Width="42"
                                            Height="28"
                                            Margin="0,0,5,0"
                                            Padding="0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#8CC6FF"
                                            Background="#17283B"
                                            BorderBrush="#365D87"
                                            Click="BtnPreview2D_Click"/>

                                    <Button x:Name="BtnPreview3D"
                                            Content="3D"
                                            Width="42"
                                            Height="28"
                                            Padding="0"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="#D0B4FF"
                                            Background="#2A2138"
                                            BorderBrush="#68528F"
                                            Click="BtnPreview3D_Click"/>

                                    <Button x:Name="BtnPreviewLarge"
                                            Content="⛶"
                                            Width="38"
                                            Height="28"
                                            Margin="5,0,0,0"
                                            Padding="0"
                                            FontSize="15"
                                            FontWeight="SemiBold"
                                            Foreground="#E8ECF2"
                                            Background="#252A34"
                                            BorderBrush="#566070"
                                            ToolTip="Vorschau vergrößern"
                                            Click="BtnPreviewLarge_Click"/>
                                </StackPanel>
                            </Grid>

                            <Border Height="330"
                                    Background="#0C0E12"
                                    BorderBrush="#2B313B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="8"
                                    ClipToBounds="True">
                                <Grid>
                                    <Image x:Name="ImgPreview"
                                           Stretch="Uniform"
                                           Cursor="Hand"
                                           MouseLeftButtonDown="ImgPreview_MouseLeftButtonDown"/>

                                    <Viewport3D x:Name="ModelViewport"
                                                Visibility="Collapsed"
                                                Focusable="True"
                                                Cursor="Hand"
                                                MouseLeftButtonDown="ModelViewport_MouseLeftButtonDown"
                                                MouseLeftButtonUp="ModelViewport_MouseLeftButtonUp"
                                                MouseRightButtonDown="ModelViewport_MouseRightButtonDown"
                                                MouseRightButtonUp="ModelViewport_MouseRightButtonUp"
                                                MouseMove="ModelViewport_MouseMove"
                                                MouseWheel="ModelViewport_MouseWheel">
                                        <Viewport3D.Camera>
                                            <PerspectiveCamera x:Name="ModelCamera"
                                                               Position="0,0,200"
                                                               LookDirection="0,0,-200"
                                                               UpDirection="0,1,0"
                                                               FieldOfView="45"/>
                                        </Viewport3D.Camera>

                                        <ModelVisual3D x:Name="ModelVisual"/>
                                        <ModelVisual3D x:Name="BuildPlateVisual"/>
                                        <ModelVisual3D x:Name="BuildVolumeWarningVisual"/>
                                    </Viewport3D>

                                    <Border x:Name="OrientationGizmoContainer"
                                            Visibility="Collapsed"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Bottom"
                                            Width="82"
                                            Height="82"
                                            Margin="10"
                                            Background="#B811141A"
                                            BorderBrush="#343B47"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            IsHitTestVisible="False">
                                        <Canvas Width="80"
                                                Height="80">
                                            <Line x:Name="AxisXLine"
                                                  X1="40" Y1="40"
                                                  X2="66" Y2="40"
                                                  Stroke="#FF6666"
                                                  StrokeThickness="2.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                            <Line x:Name="AxisYLine"
                                                  X1="40" Y1="40"
                                                  X2="40" Y2="14"
                                                  Stroke="#62D986"
                                                  StrokeThickness="2.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>
                                            <Line x:Name="AxisZLine"
                                                  X1="40" Y1="40"
                                                  X2="26" Y2="54"
                                                  Stroke="#5DA9FF"
                                                  StrokeThickness="2.4"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"/>

                                            <Ellipse Width="6"
                                                     Height="6"
                                                     Canvas.Left="37"
                                                     Canvas.Top="37"
                                                     Fill="#E6EAF0"/>

                                            <TextBlock x:Name="AxisXLabel"
                                                       Text="X"
                                                       Canvas.Left="68"
                                                       Canvas.Top="32"
                                                       Foreground="#FF8A8A"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="AxisYLabel"
                                                       Text="Y"
                                                       Canvas.Left="36"
                                                       Canvas.Top="2"
                                                       Foreground="#85E6A2"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                            <TextBlock x:Name="AxisZLabel"
                                                       Text="Z"
                                                       Canvas.Left="16"
                                                       Canvas.Top="54"
                                                       Foreground="#82BCFF"
                                                       FontSize="10"
                                                       FontWeight="Bold"/>
                                        </Canvas>
                                    </Border>
                                    <Border x:Name="Txt3DHintContainer"
                                            Visibility="Collapsed"
                                            VerticalAlignment="Bottom"
                                            HorizontalAlignment="Center"
                                            Margin="8"
                                            Padding="8,4"
                                            Background="#CC11141A"
                                            CornerRadius="5"
                                            IsHitTestVisible="False">
                                        <TextBlock x:Name="Txt3DHint"
                                                   FontSize="9"
                                                   Foreground="#AAB1BE"
                                                   TextAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Border>

                            <Border x:Name="ModelInfo3DContainer"
                                                                        Visibility="Collapsed"
                                                                        HorizontalAlignment="Stretch"
                                                                        Margin="0,10,0,0"
                                                                        Padding="11,9"
                                                                        Background="#171A21"
                                                                        BorderBrush="#343B47"
                                                                        BorderThickness="1"
                                                                        CornerRadius="6"
                                                                        IsHitTestVisible="False">
                                                                    <StackPanel>
                                                                        <TextBlock x:Name="TxtPrinterProfile3D"
                                                                                   FontSize="10"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#F0F3F8"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock x:Name="TxtModelSize3D"
                                                                                   Margin="0,3,0,0"
                                                                                   FontSize="9"
                                                                                   Foreground="#C5CBD5"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock x:Name="TxtBuildVolume3D"
                                                                                   Margin="0,2,0,0"
                                                                                   FontSize="9"
                                                                                   Foreground="#C5CBD5"
                                                                                   TextWrapping="Wrap"/>
                                                                        <TextBlock x:Name="TxtFitStatus3D"
                                                                                   Margin="0,4,0,0"
                                                                                   FontSize="9"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="#B9E6C4"
                                                                                   TextWrapping="Wrap"
                                                                                   MaxWidth="235"/>
                                                                    </StackPanel>
                                                                </Border>

                            <TextBlock x:Name="TxtDateiname"
                                       Margin="2,16,2,0"
                                       FontSize="17"
                                       FontWeight="SemiBold"
                                       Foreground="White"
                                       TextWrapping="Wrap"/>

                            <StackPanel Orientation="Horizontal"
                                        Margin="2,7,2,0">

                                <TextBlock x:Name="TxtGroesse"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           Margin="0,0,16,0"/>

                                <TextBlock x:Name="TxtDatum"
                                           FontSize="11"
                                           Foreground="{StaticResource SecondaryTextBrush}"/>

                            </StackPanel>

                            <TextBlock x:Name="TxtPrintInfoHeading" Text="DRUCKINFORMATIONEN"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,26,0,10"/>

                            <Border Background="{StaticResource PanelLightBrush}"
                                    BorderBrush="#2B313B"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="16">

                                <Grid>

                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="135"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="34"/>
                                        <RowDefinition Height="34"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0"
                                               Grid.Column="0"
                                               x:Name="LblPrintTime" Text="Druckzeit"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtDruckzeit"
                                               Grid.Row="0"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="1"
                                               Grid.Column="0"
                                               x:Name="LblMaterial" Text="Material"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtMaterial"
                                               Grid.Row="1"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="2"
                                               Grid.Column="0"
                                               x:Name="LblFilament" Text="Filament"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtFilament"
                                               Grid.Row="2"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="3"
                                               Grid.Column="0"
                                               x:Name="LblFilamentLength" Text="Filamentlänge"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtFilamentLaenge"
                                               Grid.Row="3"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="4"
                                               Grid.Column="0"
                                               x:Name="LblNozzle" Text="Düse"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtDuese"
                                               Grid.Row="4"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="5"
                                               Grid.Column="0"
                                               x:Name="LblPrintProfile" Text="Druckprofil"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Top"
                                               Margin="0,8,0,8"/>

                                    <TextBlock x:Name="TxtDruckprofil"
                                               Grid.Row="5"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,8"/>

                                    <TextBlock Grid.Row="6"
                                               Grid.Column="0"
                                               x:Name="LblBuildPlate" Text="Druckplatte"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Top"
                                               Margin="0,8,0,8"/>

                                    <TextBlock x:Name="TxtDruckplatte"
                                               Grid.Row="6"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               Margin="0,8,0,8"/>

                                    <TextBlock Grid.Row="7"
                                               Grid.Column="0"
                                               x:Name="LblBambuStudio" Text="Bambu Studio"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtBambuStudio"
                                               Grid.Row="7"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>

                                    <TextBlock Grid.Row="8"
                                               Grid.Column="0"
                                               x:Name="LblSupport" Text="Support"
                                               Foreground="{StaticResource SecondaryTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <TextBlock x:Name="TxtSupport"
                                               Grid.Row="8"
                                               Grid.Column="1"
                                               Text="–"
                                               Foreground="White"
                                               VerticalAlignment="Center"/>

                                </Grid>

                            </Border>

                        </StackPanel>

                    </ScrollViewer>

                </Border>

            </Grid>

            <!-- STATUSLEISTE -->

            <Border Grid.Row="3"
                    Background="#14171D"
                    BorderBrush="#292E37"
                    BorderThickness="0,1,0,0">

                <Grid Margin="18,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock x:Name="TxtStatus"
                               Grid.Column="0"
                               Text="3MF-Explorer"
                               VerticalAlignment="Center"
                               Foreground="#727B89"
                               FontSize="11"/>

                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <TextBlock x:Name="TxtUpdate"
                                   Foreground="#4C8DFF"
                                   Cursor="Hand"
                                   FontSize="11"
                                   Margin="0,0,18,0"
                                   Visibility="Collapsed"
                                   MouseLeftButtonUp="TxtUpdate_MouseLeftButtonUp"/>

                        <TextBlock x:Name="TxtVersion"
                                   Foreground="#727B89"
                                   FontSize="11"/>

                    </StackPanel>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>