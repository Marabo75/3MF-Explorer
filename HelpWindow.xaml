<Window x:Class="ThreeMFExplorer.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="3MF-Explorer – Hilfe"
        Width="1000"
        Height="720"
        MinWidth="800"
        MinHeight="550"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#0F1115"
        Foreground="#F2F4F7">

    <WindowChrome.WindowChrome>
        <shell:WindowChrome
            CaptionHeight="0"
            ResizeBorderThickness="6"
            CornerRadius="0"
            GlassFrameThickness="0"
            UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <SolidColorBrush x:Key="PanelBrush" Color="#171A21"/>
        <SolidColorBrush x:Key="PanelLightBrush" Color="#1D212A"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#2A303B"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F7"/>
        <SolidColorBrush x:Key="SecondaryTextBrush" Color="#939BAA"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>

        <!-- Navigationsbuttons -->

        <Style x:Key="NavigationButtonStyle"
               TargetType="Button">

            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Foreground" Value="#DDE1E7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="7">

                            <ContentPresenter
                                Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#252A34"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                            <Trigger Property="IsPressed"
                                     Value="True">

                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="#1F6FEB"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Schließen -->

        <Style x:Key="CloseButtonStyle"
               TargetType="Button">

            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#DDE1E7"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Cursor" Value="Arrow"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="Button">

                        <Border x:Name="CloseBorder"
                                Background="{TemplateBinding Background}">

                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>

                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver"
                                     Value="True">

                                <Setter TargetName="CloseBorder"
                                        Property="Background"
                                        Value="#C42B1C"/>

                                <Setter Property="Foreground"
                                        Value="#FFFFFF"/>

                            </Trigger>

                        </ControlTemplate.Triggers>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

        <!-- Dunkle Scrollbars -->

        <Style TargetType="ScrollBar">

            <Setter Property="Width" Value="10"/>
            <Setter Property="Background" Value="#11141A"/>

            <Setter Property="Template">
                <Setter.Value>

                    <ControlTemplate TargetType="ScrollBar">

                        <Grid Background="#11141A">

                            <Track x:Name="PART_Track"
                                   IsDirectionReversed="True">

                                <Track.DecreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageUpCommand"
                                        Opacity="0"
                                        Focusable="False"/>

                                </Track.DecreaseRepeatButton>

                                <Track.Thumb>

                                    <Thumb>

                                        <Thumb.Template>

                                            <ControlTemplate TargetType="Thumb">

                                                <Border x:Name="ThumbBorder"
                                                        Background="#3B4350"
                                                        CornerRadius="5"
                                                        Margin="2"/>

                                                <ControlTemplate.Triggers>

                                                    <Trigger Property="IsMouseOver"
                                                             Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#596474"/>

                                                    </Trigger>

                                                    <Trigger Property="IsDragging"
                                                             Value="True">

                                                        <Setter TargetName="ThumbBorder"
                                                                Property="Background"
                                                                Value="#4C8DFF"/>

                                                    </Trigger>

                                                </ControlTemplate.Triggers>

                                            </ControlTemplate>

                                        </Thumb.Template>

                                    </Thumb>

                                </Track.Thumb>

                                <Track.IncreaseRepeatButton>

                                    <RepeatButton
                                        Command="ScrollBar.PageDownCommand"
                                        Opacity="0"
                                        Focusable="False"/>

                                </Track.IncreaseRepeatButton>

                            </Track>

                        </Grid>

                    </ControlTemplate>

                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <Border BorderBrush="#292E37"
            BorderThickness="1,0,1,1"
            Background="#0F1115">

        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="38"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="44"/>
            </Grid.RowDefinitions>

            <!-- TITELLEISTE -->

            <Border Grid.Row="0"
                    Background="#14171D"
                    BorderBrush="#292E37"
                    BorderThickness="0,0,0,1"
                    MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">

                <Grid>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="12,0,0,0"
                                IsHitTestVisible="False">

                        <Image Source="3MF-Explorer.ico"
                               Width="18"
                               Height="18"
                               Margin="0,0,9,0"/>

                        <TextBlock x:Name="TxtWindowTitle"
                                   Text="3MF-Explorer – Hilfe"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="#E8EBF0"
                                   VerticalAlignment="Center"/>

                    </StackPanel>

                    <Button x:Name="BtnClose"
                            Grid.Column="1"
                            Content="×"
                            ToolTip="Schließen"
                            Style="{StaticResource CloseButtonStyle}"
                            Click="BtnClose_Click"/>

                </Grid>

            </Border>

            <!-- HAUPTBEREICH -->

            <Grid Grid.Row="1">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="235"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- NAVIGATION -->

                <Border Grid.Column="0"
                        Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="0,0,1,0">

                    <Grid Margin="14">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0"
                                    Margin="8,12,8,18">

                            <TextBlock Text="3MF-Explorer"
                                       FontSize="21"
                                       FontWeight="SemiBold"
                                       Foreground="White"/>

                            <TextBlock x:Name="TxtGuideSubtitle"
                                       Text="Bedienungsanleitung"
                                       FontSize="12"
                                       Foreground="{StaticResource SecondaryTextBrush}"
                                       Margin="0,3,0,0"/>

                        </StackPanel>

                        <StackPanel Grid.Row="1">

                            <Button x:Name="BtnNavStart"
                                    Content="Erste Schritte"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Tag="Start"
                                    Click="Navigation_Click"/>

                            <Button x:Name="BtnNavFolders"
                                    Content="Ordner &amp; Navigation"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Tag="Folders"
                                    Click="Navigation_Click"/>

                            <Button x:Name="BtnNavGallery"
                                    Content="Galerie"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Tag="Gallery"
                                    Click="Navigation_Click"/>

                            <Button x:Name="BtnNavPreview"
                                    Content="Vorschau &amp; Druckdaten"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Tag="Preview"
                                    Click="Navigation_Click"/>

                            <Button x:Name="BtnNavFiles"
                                    Content="Dateien verwalten"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Tag="Files"
                                    Click="Navigation_Click"/>

                            <Button x:Name="BtnNavKeyboard"
                                    Content="Tastenkürzel"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Tag="Keyboard"
                                    Click="Navigation_Click"/>

                            <Button x:Name="BtnNavUpdates"
                                    Content="Updates"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Tag="Updates"
                                    Click="Navigation_Click"/>

                            <Button x:Name="BtnNavAbout"
                                    Content="Über 3MF-Explorer"
                                    Style="{StaticResource NavigationButtonStyle}"
                                    Tag="About"
                                    Click="Navigation_Click"/>

                        </StackPanel>

                    </Grid>

                </Border>

                <!-- HILFEINHALT -->

                <ScrollViewer Grid.Column="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <StackPanel Margin="38,32,38,40">

                        <TextBlock x:Name="TxtHelpTitle"
                                   Text="Erste Schritte"
                                   FontSize="27"
                                   FontWeight="SemiBold"
                                   Foreground="White"
                                   Margin="0,0,0,8"/>

                        <TextBlock x:Name="TxtHelpSubtitle"
                                   Text="Willkommen bei 3MF-Explorer"
                                   FontSize="14"
                                   Foreground="#939BAA"
                                   Margin="0,0,0,26"/>

                        <Border Background="{StaticResource PanelLightBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="10"
                                Padding="24">

                            <TextBlock x:Name="TxtHelpContent"
                                       Foreground="#DDE1E7"
                                       FontSize="14"
                                       LineHeight="23"
                                       TextWrapping="Wrap"/>

                        </Border>

                    </StackPanel>

                </ScrollViewer>

            </Grid>

            <!-- FUSSZEILE -->

            <Border Grid.Row="2"
                    Background="#14171D"
                    BorderBrush="#292E37"
                    BorderThickness="0,1,0,0">

                <Grid Margin="18,0">

                    <TextBlock x:Name="TxtHelpVersion"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Foreground="#727B89"
                               FontSize="11"/>

                </Grid>

            </Border>

        </Grid>

    </Border>

</Window>